# Masar Platform — Environment Variables
# Copy to .env and fill in your actual values. Never commit real secrets.

# Application
DEBUG=True
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/masar
DATABASE_ECHO=False
PGVECTOR_ENABLED=True

# Vector Store Backend: "pgvector" or "chromadb"
VECTOR_STORE_BACKEND=pgvector

# ChromaDB (only if VECTOR_STORE_BACKEND=chromadb)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=masar_knowledge

# LLM Provider: "nvidia" or "ollama"
LLM_PROVIDER=ollama

# NVIDIA NIM
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# vLLM (optional local inference)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=EMPTY

# Embedding Provider: "nvidia" or "ollama"
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSION=768

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# RAG Settings
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# File Uploads
UPLOAD_DIR=./uploads
