# Masar Platform — Root Environment Variables
# Copy to .env and fill in your actual values. Never commit real secrets.

# ─── Application ───
DEBUG=True
ENVIRONMENT=development

# ─── Backend (FastAPI) ───
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/masar
# For SQLite development (no PostgreSQL needed):
DATABASE_URL=sqlite:///./masar.db

# ─── Frontend ───
VITE_API_URL=http://localhost:8000/api/v1

# ─── NVIDIA NIM (for AI Agents) ───
# Get your key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# ─── LLM Provider: "nvidia" or "ollama" ───
LLM_PROVIDER=ollama

# ─── Ollama (if using local LLM) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b